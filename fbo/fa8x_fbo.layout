# FA8X Walkaround FBO, built by tools/gse/fbo_make.py
# FBO frame: x right, y towards the airside door, z up, metres
room -12 12 -7.5 7.5 4
briefing -17.5 -12.15 -7.5 -1 3
door -1 1 7.25 7.5 0 2.45
start 0 -2.6 0
grid -17.5 -7.5 0.1 295 150
# the screens the plugin paints: lower left, lower right, upper right, upper left as seen from
# the room (12 numbers), then the rows of its 2048 x 1024 texture it fills; the departure board,
# the weather map round the airport, the airport's D-ATIS and winds aloft, the SimBrief flight plan
board 11.8357 -1.6533 1.6620 11.8357 -5.1467 1.6620 11.8357 -5.1467 3.1501 11.8357 -1.6533 3.1501 872
wxmap -17.3646 -5.6480 1.0572 -17.3646 -3.5520 1.0572 -17.3646 -3.5520 1.9500 -17.3646 -5.6480 1.9500 872
wxtext -17.3791 -2.8487 1.3548 -17.3791 -1.4513 1.3548 -17.3791 -1.4513 1.9500 -17.3791 -2.8487 1.9500 872
ofp -15.7733 -1.0882 1.1560 -14.0267 -1.0882 1.1560 -14.0267 -1.0882 1.9000 -15.7733 -1.0882 1.9000 872
# one row per line from y0 up, '.' free, '#' blocked
